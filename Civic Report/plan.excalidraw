      "updated": 1786340151978,
      "link": null,
      "locked": false,
      "text": "Civic Report is a API where citizens can post\nabout the civic issues they are facing in day\nto day life and can track over all the issues\nwhether they are resolved and pending one's\n\nFunctionalities:\n- Field to enter image\n- See the issue posted by all citizens\n- Get a stats of how many issues resolved vs \nhow many pending and govt working rate\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Civic Report is a API where citizens can post\nabout the civic issues they are facing in day\nto day life and can track over all the issues\nwhether they are resolved and pending one's\n\nFunctionalities:\n- Field to enter image\n- See the issue posted by all citizens\n- Get a stats of how many issues resolved vs \nhow many pending and govt working rate\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
