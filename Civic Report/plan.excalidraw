      "index": "aS",
      "roundness": null,
      "seed": 2084158801,
      "version": 69,
      "versionNonce": 647018065,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786350066036,
      "link": null,
      "locked": false,
      "text": "Citizen\n│\n├── POST /citizens\n├── GET /citizens\n├── GET /citizens/{id}\n└── GET /citizens/{id}/issues\n\n\nIssues\n│\n├── POST /issues\n├── GET /issues\n│      │\n│      ├── ?category=\n│      ├── ?location=\n│      └── ?status=\n│\n├── GET /issues/{id}\n├── PATCH /issues/{id}/status\n└── DELETE /issues/{id}\n\n\nAnalytics\n│\n└── GET /stats\n    │\n    ├── Total issues\n    ├── Open issues\n    ├── In-progress issues\n    ├── Resolved issues\n    └── Resolution rate",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Citizen\n│\n├── POST /citizens\n├── GET /citizens\n├── GET /citizens/{id}\n└── GET /citizens/{id}/issues\n\n\nIssues\n│\n├── POST /issues\n├── GET /issues\n│      │\n│      ├── ?category=\n│      ├── ?location=\n│      └── ?status=\n│\n├── GET /issues/{id}\n├── PATCH /issues/{id}/status\n└── DELETE /issues/{id}\n\n\nAnalytics\n│\n└── GET /stats\n    │\n    ├── Total issues\n    ├── Open issues\n    ├── In-progress issues\n    ├── Resolved issues\n    └── Resolution rate",
      "autoResize": true,
      "lineHeight": 1.25
    },
