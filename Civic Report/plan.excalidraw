    {
      "id": "dC04F_egPALxMMFZp9IuV",
      "type": "text",
      "x": 401.3023219484279,
      "y": 533.470568506967,
      "width": 459.91552734375,
      "height": 1085,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
