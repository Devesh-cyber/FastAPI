    {
      "id": "6q6NHQ4gOc3y2PWc_jENX",
      "type": "text",
      "x": 621,
      "y": 136,
      "width": 615.9992065429688,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
