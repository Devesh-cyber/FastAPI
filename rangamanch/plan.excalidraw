      "seed": 618266654,
      "version": 524,
      "versionNonce": 130849054,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785732301187,
      "link": null,
      "locked": false,
      "text": "Rangamanch a Pune-based theathre booking startup needs a\nreviews API so audiences can rate and review plays. The\nAPI powers their app's review section and average rating\ndisplays.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rangamanch a Pune-based theathre booking startup needs a\nreviews API so audiences can rate and review plays. The\nAPI powers their app's review section and average rating\ndisplays.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AZXVlkAuVchsnfPh6Eeog",
      "type": "text",
      "x": 612,
      "y": 314,
      "width": 648.9992065429688,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1229457218,
      "version": 256,
      "versionNonce": 1133233986,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785732404748,
      "link": null,
      "locked": false,
      "text": "A full CRUD API backed by SQLite - create, read, update and\ndelete reviews, plus get average ratings as per play with \npagination support.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A full CRUD API backed by SQLite - create, read, update and\ndelete reviews, plus get average ratings as per play with \npagination support.",
      "autoResize": true,
      "lineHeight": 1.25
    },
